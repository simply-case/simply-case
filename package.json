{
  "name": "mycasepro",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mycasepro/web",
    "dev:web": "npm run dev --workspace @mycasepro/web",
    "build:web": "npm run build --workspace @mycasepro/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/database.types.ts",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "test": "node --test supabase/functions/_shared/*.test.ts packages/shared/src/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
