# ---------------------------------------------------------------
# Copy to apps/web/.env.local and fill in. Never commit real values.
# Values come from: Supabase dashboard > Project Settings > API Keys
# ---------------------------------------------------------------

# Safe to expose to the browser (RLS is what protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://ltpvagdbprwzqtasurez.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Used to build the magic-link redirect URL. Update to the real domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_, never import into a client component.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend — case-status notification email (Phase 6).
# Separate from the Supabase Auth sender, which is set in the dashboard
# (Project Settings > Authentication > SMTP). While on onboarding@resend.dev
# with no verified domain, Resend only delivers to the account owner.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="mycase pro <onboarding@resend.dev>"

# USCIS developer API (Phase 2)
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
