# Expo only inlines env vars prefixed EXPO_PUBLIC_ into the JS bundle at
# build time (same idea as Next.js's NEXT_PUBLIC_ prefix). Both are safe to
# expose — RLS protects the data, not the secrecy of these values. Copy to
# .env and fill in from Project Settings > API Keys, same as apps/web.

EXPO_PUBLIC_SUPABASE_URL=https://ltpvagdbprwzqtasurez.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
